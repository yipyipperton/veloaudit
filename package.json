{
  "name": "veloaudit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
