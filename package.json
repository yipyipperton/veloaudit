    "db:migrate": "prisma migrate deploy",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "bullmq": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
