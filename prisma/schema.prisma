generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum Strategy {
  MOBILE
  DESKTOP
}

enum MetricSource {
  LAB
  FIELD
}

/// One user submission. Groups the per-device audits (mobile + desktop) that run in parallel.
model AuditRun {
  id        String   @id @default(cuid(2))
  /// sha256 of the anonymous owner id from the signed session cookie (null = legacy/ownerless, hidden from lists)
  ownerHash String?
  url       String
  createdAt DateTime @default(now())
  audits    Audit[]

  @@index([ownerHash, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Audit {
  id          String      @id @default(cuid(2))
  runId       String?
  run         AuditRun?   @relation(fields: [runId], references: [id], onDelete: Cascade)
  ownerHash   String?
  url         String
  strategy    Strategy
  status      AuditStatus @default(QUEUED)
  errorCode   String?
  errorMessage String?
  createdAt   DateTime    @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  finalUrl          String?
  lighthouseVersion String?
  fetchTime         String?

  // Lighthouse lab metrics (null = not reported by Lighthouse)
  labScore      Float?
  labLcpMs      Float?
  labFcpMs      Float?
  labSpeedIndexMs Float?
  labTbtMs      Float?
  labCls        Float?
  labTtfbMs     Float?

  // CrUX field metrics (null = unavailable; never derived from lab data)
  fieldScope       String?   // "url" | "origin" | null when no field data
  fieldOverall     String?
  fieldLcpMs       Float?
  fieldLcpCategory String?
  fieldInpMs       Float?
  fieldInpCategory String?
  fieldCls         Float?
  fieldClsCategory String?
  fieldFcpMs       Float?
  fieldFcpCategory String?
  fieldTtfbMs      Float?
  fieldTtfbCategory String?

  // Lighthouse category scores 0-100 (performance = labScore). null = not scored / audit predates categories.
  accessibilityScore Float?
  bestPracticesScore Float?
  seoScore           Float?
  /// Per-category failed audits (with details) and passed / manual / not-applicable refs, grouped like PSI.
  categories    Json?
  opportunities Json?
  diagnostics   Json?
  /// Lighthouse per-metric scores 0-1 ({ lcp, fcp, si, tbt, cls }), used for threshold indicators.
  labMetricScores Json?
  /// CrUX histogram per metric: { lcp: [good, needsImprovement, poor], ... } as proportions 0-1.
  fieldDistributions Json?
  assets AuditAsset[]

  @@index([runId])
  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([url, strategy, createdAt(sort: Desc)])
  @@index([ownerHash, createdAt(sort: Desc)])
  @@index([ownerHash, url, strategy, createdAt(sort: Desc)])
}

/// User-defined performance target, evaluated against an explicit source (lab or field).
model Budget {
  id        String       @id @default(cuid(2))
  ownerHash String?
  url       String
  strategy  Strategy
  source    MetricSource
  metric    String // e.g. "lcp", "inp", "cls", "score"
  threshold Float
  createdAt DateTime     @default(now())

  @@unique([ownerHash, url, strategy, source, metric])
  @@index([ownerHash, url, strategy])
}

/// Screenshot bytes decoded from Lighthouse data URIs in the PSI response (never fetched from the target site).
model AuditAsset {
  id       String @id @default(cuid(2))
  auditId  String
  audit    Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  kind     String // "final" | "thumb"
  idx      Int
  mime     String
  timingMs Float?
  data     Bytes

  @@unique([auditId, kind, idx])
}
