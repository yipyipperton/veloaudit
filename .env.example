DATABASE_URL="postgresql://velo:velo@localhost:5432/veloaudit?schema=public"
REDIS_URL="redis://localhost:6379"
# Optional. Without it, keyless PSI requests are attempted (heavily rate-limited by Google).
PSI_API_KEY=""
# "system" (default) or "doh" (Google DNS-over-HTTPS) where system DNS returns synthetic IPs.
DNS_RESOLVER="system"
AUDIT_QUEUE_NAME="audits"
AUDIT_JOB_TIMEOUT_MS="300000"
WORKER_CONCURRENCY="4"

# Required in production: HMAC key for the anonymous owner cookie (>= 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET=""
